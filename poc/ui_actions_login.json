[
  {
    "do": "liveness"
  },
  {
    "do": "open_provider",
    "x": 200,
    "y": 629,
    "timeout": 200,
    "per_try": 30
  },
  {
    "do": "shot",
    "name": "login-01-form"
  },
  {
    "do": "devshot",
    "name": "baseline-empty"
  },

  {
    "do": "clickrow",
    "row": 2,
    "wait": 1.0
  },
  {
    "do": "type",
    "text": "poc@yahoo.com"
  },

  {
    "do": "clickrow",
    "row": 4,
    "wait": 1.0
  },
  {
    "do": "type",
    "text": "PocPassw0rd!"
  },

  {
    "do": "shot",
    "name": "login-02-filled"
  },
  {
    "do": "assert_diff",
    "ref": "baseline-empty",
    "min_delta": 1.0
  },
  {
    "do": "devshot",
    "name": "filled-device"
  },
  {
    "do": "clickgreen",
    "wait": 4.0
  },
  {
    "do": "sleep",
    "seconds": 20
  },
  {
    "do": "shot",
    "name": "login-03-after-connect"
  },
  {
    "do": "expect_login",
    "email": "poc@yahoo.com"
  },
  {
    "do": "shot",
    "name": "login-04-result"
  },
  {
    "do": "devshot",
    "name": "final-device"
  }
]
